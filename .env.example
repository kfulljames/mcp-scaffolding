# Copy to .env for local development. Never commit a real .env file.
#
# Every value here is validated at startup by src/config/schema.ts.
# An invalid or missing required value fails the server at boot, not
# at the first tool call — see docs/KNOWN-GOTCHAS.md.

# --- Transport ------------------------------------------------------------
# "stdio" for local dev / editor integration, "http" for a hosted deployment.
# This is explicit on purpose: inferring transport from whether PORT is set
# is a real footgun observed in the wild (see MCP-SCAFFOLD-REFERENCE.md).
TRANSPORT=stdio

# Only read when TRANSPORT=http.
PORT=3000

# --- Server identity --------------------------------------------------------
SERVER_NAME=example-mcp-server
SERVER_VERSION=0.1.0

# --- Safety -----------------------------------------------------------------
# true removes every write tool from the advertised tool surface entirely.
# This is the default for a reason: the secure path must be the easy path.
READ_ONLY=true

# Comma-separated list of preset names to expose. See src/server/presets.ts.
MCP_PRESETS=service-desk

# --- Auth ---------------------------------------------------------------
# none        - single-tenant local dev only. Refuses to start with TRANSPORT=http.
# api-key      - static bearer token, one tenant per key (see docs/AUTHENTICATION.md)
# entra        - OAuth 2.1 / Microsoft Entra ID, multi-tenant
AUTH_MODE=none

# Required when AUTH_MODE=api-key. Comma-separated key:subjectId:organizationId:role1|role2
# entries — local dev / simple deployments only. See src/auth/http-authenticator.ts
# and docs/AUTHENTICATION.md.
# API_KEYS=demo-key:local-dev:local:admin

# Read by EnvCredentialProvider (dev only — see src/auth/credential-provider.ts) as
# `${VENDOR}_API_KEY`. The demo server in src/index.ts uses vendor name "mockvendor".
MOCKVENDOR_API_KEY=demo-not-a-real-secret

# Required when AUTH_MODE=entra.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# --- Vendor -------------------------------------------------------------
# Base URL of the vendor API this server wraps. Vendor credentials themselves
# are NEVER set here — they are resolved per-tenant through CredentialProvider
# (Key Vault / Secrets Manager / etc). See src/auth/credential-provider.ts.
VENDOR_BASE_URL=https://api.example-vendor.test

# --- Timeouts & limits ----------------------------------------------------
REQUEST_TIMEOUT_MS=10000
VENDOR_TIMEOUT_MS=8000
MAX_RESPONSE_BYTES=262144
MAX_PAGE_SIZE=100
MAX_PAGES_PER_CALL=10

# Per-authenticated-principal token bucket at the HTTP boundary. Not read over stdio
# (single local caller). See src/safety/rate-limiter.ts.
RATE_LIMIT_PER_MINUTE=120

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
# json (production) or pretty (local dev only — never in a shipped container)
LOG_FORMAT=pretty
